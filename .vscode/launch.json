{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Run Dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 9229,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run App Launcher (Script)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "run-app.bat"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
