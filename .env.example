# -------------------------------------------------------------
# SecureDocX (Secure Document Exchange Portal) Environment Configuration
# -------------------------------------------------------------

# Application Port and Base URL
PORT=3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Authentication & Cryptography Secrets
JWT_SECRET=fortress-share-super-secret-key-change-this-in-production-1029384756
KMS_MASTER_KEY=fortress-kms-master-key-secure-seed-98234120984124981

# Database Connection (SQLite Default)
DATABASE_URL="file:./dev.db"

# -------------------------------------------------------------
# Blockchain Infrastructure (Ethereum / Sepolia / Hardhat)
# -------------------------------------------------------------
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
# Private key for the account executing on-chain proof registrations (Never expose to frontend!)
BLOCKCHAIN_PRIVATE_KEY=
# Address of the deployed FileAuditRegistry smart contract
SMART_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# -------------------------------------------------------------
# AI Security Sentinel (FastAPI Python Service)
# -------------------------------------------------------------
AI_ENGINE_URL=http://127.0.0.1:8000
