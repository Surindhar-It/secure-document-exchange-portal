# -------------------------------------------------------------
# SecureDocX (Secure Document Exchange Portal) Environment Configuration
# -------------------------------------------------------------

# Application Port and Base URL
PORT=3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Authentication & Cryptography Secrets
JWT_SECRET=fortress-share-super-secret-key-change-this-in-production-1029384756
KMS_MASTER_KEY=fortress-kms-master-key-secure-seed-98234120984124981
OTP_SECRET=securedocx-email-otp-hmac-secret-k3y-v1-987234091283

# Database Connection:
# Local SQLite (Development fallback):
# DATABASE_URL="file:./dev.db"

# Supabase Cloud PostgreSQL (Recommended for Production & Cloud Deployment):
# Obtain from Supabase Project Settings -> Database -> Connection string -> Prisma
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------
# Secure Email Delivery & OTP Configuration (Gmail SMTP / Resend / Brevo)
# -------------------------------------------------------------
# Option 1: Gmail SMTP (Standard)
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM='"SecureDocX Portal" <your_email@gmail.com>'

# Option 2: Resend HTTP API (Port 443 HTTPS - Recommended for Render Free Tier which blocks SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="SecureDocX <onboarding@resend.dev>"

# Option 3: Brevo HTTP API (Port 443 HTTPS)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 4: Custom / Cloud SMTP (Amazon SES, SendGrid, Mailgun)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587

# Simulated Delivery in Dev/Test environments when SMTP ports are unreachable
ALLOW_SIMULATED_OTP=true

# -------------------------------------------------------------
# Blockchain Infrastructure (Ethereum / Sepolia / Hardhat)
# -------------------------------------------------------------
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
# Private key for the account executing on-chain proof registrations (Never expose to frontend!)
BLOCKCHAIN_PRIVATE_KEY=
# Address of the deployed FileAuditRegistry smart contract
SMART_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# -------------------------------------------------------------
# AI Security Sentinel (FastAPI Python Service)
# -------------------------------------------------------------
AI_ENGINE_URL=http://127.0.0.1:8000
